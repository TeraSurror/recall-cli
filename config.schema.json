{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultVault": {
      "type": "string"
    },
    "defaultProfile": {
      "type": "string"
    },
    "vaults": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "default": "ask",
            "type": "string",
            "enum": [
              "read-only",
              "ask",
              "auto"
            ]
          },
          "mcpMode": {
            "default": "read-only",
            "type": "string",
            "enum": [
              "read-only",
              "ask",
              "auto"
            ]
          },
          "exclude": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "embeddings": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "providers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai",
              "google",
              "ollama",
              "openai-compatible"
            ]
          },
          "apiKey": {
            "type": "string"
          },
          "baseURL": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "profiles": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxOutputTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tools": {
            "default": true,
            "type": "boolean"
          },
          "maxSteps": {
            "default": 25,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "provider",
          "model"
        ]
      }
    },
    "embeddings": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ]
    }
  }
}
