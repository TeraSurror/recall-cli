{
  "name": "recall",
  "version": "2.0.0-alpha.0",
  "description": "Agentic TUI hub for all your Obsidian vaults — any LLM, local or hosted",
  "type": "module",
  "bin": {
    "recall": "./src/cli/entry.ts"
  },
  "scripts": {
    "start": "bun run src/cli/entry.ts",
    "dev": "bun --watch run src/cli/entry.ts",
