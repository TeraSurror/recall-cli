    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.163",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "ollama-ai-provider-v2": "^4.1.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
